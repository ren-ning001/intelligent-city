# 复制为 .env 后填写，绝对不要提交真实密钥。
DEEPSEEK_API_KEY=

# DSH默认值可按账号实际可用模型调整。
ZYOURROAD_DSH_MODEL=deepseek-v4-flash

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 新城市实时OSM查询：单端点超时、失败冷却与备用端点。
OVERPASS_TIMEOUT_SECONDS=35
OVERPASS_FAILURE_COOLDOWN_SECONDS=90
OVERPASS_ENDPOINTS=https://overpass-api.de/api,https://overpass.kumi.systems/api,https://overpass.nchc.org.tw/api
